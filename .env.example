# Copy to a local .env file or export these variables in your shell.
# Never commit real credentials or restricted-data locations.

TRUST_ICU_POSTGRES_DSN=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
TRUST_ICU_MIMIC_ROOT=/secure/path/to/mimiciv/3.1
TRUST_ICU_EICU_ROOT=/secure/path/to/eicu/2.0
TRUST_ICU_AMSTERDAM_ROOT=/secure/path/to/amsterdamumcdb/1.5.0
TRUST_ICU_HIRID_ROOT=/secure/path/to/hirid/1.1.1
TRUST_ICU_OUTPUT_ROOT=/secure/path/to/trust_icu_outputs
